{%- comment -%}
  Testimonials & Social Proof Section
{%- endcomment -%}

<section class="testimonials-section" style="--bg-color: {{ section.settings.background_color }}; --text-color: {{ section.settings.text_color }};">
  <div class="testimonials__container">
    {%- if section.settings.title != blank -%}
      <h2 class="testimonials__heading">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="testimonials__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="testimonial-card" {{ block.shopify_attributes }}>
            <div class="testimonial-card__stars">★★★★★</div>
            <p class="testimonial-card__quote">"{{ block.settings.quote | default: "Exceptional quality and incredible service. Highly recommended!" }}"</p>
            <div class="testimonial-card__author">
              <strong>{{ block.settings.author | default: "Verified Buyer" }}</strong>
              {%- if block.settings.source != blank -%}
                <span>— {{ block.settings.source }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="testimonial-card">
            <div class="testimonial-card__stars">★★★★★</div>
            <p class="testimonial-card__quote">"The absolute best purchase I've made this year. Beautifully packaged and arrived super fast!"</p>
            <div class="testimonial-card__author">
              <strong>Happy Customer {{ i }}</strong>
              <span>— Verified Buyer</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F9F9F9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Exceptional quality and incredible service. Highly recommended!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "source",
          "label": "Subtitle / Source",
          "default": "Verified Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
