{{ 'section-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-hero.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #shopify-section-{{ section.id }} .hero-variant-editorial {
    --hero-bg-color: {{ section.settings.background_color | default: '#1a1816' }};
    --hero-text-color: {{ section.settings.text_color | default: '#f7f4ef' }};
    --hero-accent-color: {{ section.settings.accent_color | default: '#c9a86a' }};
  }
{%- endstyle -%}

<hero-section class="hero-registry-section hero-variant-editorial" id="Hero-{{ section.id }}">
  <div class="hero-editorial-container">
    <div class="hero-editorial-media">
      {% render 'hero-media', section: section %}
      <div class="hero-editorial-overlay-card">
        <span class="hero-editorial-issue">EDITION N° 04</span>
        <h1 class="hero-editorial-title">{{ section.settings.heading | default: "Artisanal Grace" }}</h1>
        <p class="hero-editorial-subtext">{{ section.settings.subheading | default: "A curated reflection on quiet luxury and timeless structural design." }}</p>
        {%- if section.settings.primary_button_label != blank -%}
          <a href="{{ section.settings.primary_button_link | default: '#' }}" class="hero-editorial-btn">
            {{ section.settings.primary_button_label }} &rarr;
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</hero-section>

{% schema %}
{
  "name": "Hero Editorial Overlay",
  "class": "section-hero",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#1a1816" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#f7f4ef" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#c9a86a" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Artisanal Grace" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A curated reflection on quiet luxury and timeless structural design." },
    { "type": "text", "id": "primary_button_label", "label": "Primary Button", "default": "View Editorial" },
    { "type": "url", "id": "primary_button_link", "label": "Primary Button Link" }
  ]
}
{% endschema %}
