{% comment %}
  Renders Payment Method Badges with SVG Icons and Native Shopify Fallbacks
{% endcomment %}

<div class="footer-payment-icons">
  {% if shop.enabled_payment_types.size > 0 %}
    {% for type in shop.enabled_payment_types %}
      {{ type | payment_type_svg_tag: class: 'payment-icon' }}
    {% endfor %}
  {% else %}
    <span class="payment-badge-svg" title="Visa">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="24" viewBox="0 0 36 24" fill="none"><rect width="36" height="24" rx="4" fill="#1A1F71"/><path d="M14.5 16.5L16.2 6.5H18.7L17 16.5H14.5ZM23.8 6.7C23.3 6.5 22.5 6.3 21.6 6.3C19 6.3 17.2 7.6 17.2 9.5C17.2 10.9 18.5 11.7 19.5 12.2C20.5 12.7 20.8 13 20.8 13.5C20.8 14.2 19.9 14.5 19.1 14.5C18 14.5 17.3 14.3 16.6 14L16.2 16C17 16.4 18.2 16.7 19.4 16.7C22.2 16.7 24 15.3 24 13.3C24 11.2 21.1 11 21.1 9.9C21.1 9.5 21.5 9 22.5 8.9C23 8.9 23.8 9 24.5 9.3L24.8 7.3L23.8 6.7ZM28.5 6.5H26.5C25.9 6.5 25.4 6.7 25.2 7.2L21.5 16.5H24.2L24.7 15H28L28.3 16.5H30.7L28.5 6.5ZM25.4 13L26.5 9.8L27.2 13H25.4ZM13.8 6.5L11.4 13.3L11.1 11.9C10.6 10.2 9.1 8.3 7.3 7.4L9.5 16.5H12.2L16.3 6.5H13.8Z" fill="white"/></svg>
    </span>
    <span class="payment-badge-svg" title="Mastercard">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="24" viewBox="0 0 36 24" fill="none"><rect width="36" height="24" rx="4" fill="#0A0A0A"/><circle cx="14" cy="12" r="7" fill="#EB001B"/><circle cx="22" cy="12" r="7" fill="#F79E1B"/><path d="M18 6.6A6.97 6.97 0 0 0 15.5 12c0 2.2.9 4.2 2.5 5.4a6.97 6.97 0 0 0 2.5-5.4c0-2.2-.9-4.2-2.5-5.4Z" fill="#FF5F00"/></svg>
    </span>
    <span class="payment-badge-svg" title="Amex">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="24" viewBox="0 0 36 24" fill="none"><rect width="36" height="24" rx="4" fill="#006FCF"/><path d="M7 10h3l1 2 1-2h3v4h-2v-2.5L11.5 14h-1L9 11.5V14H7v-4zm10 0h4v1h-2.5v.5H21v1h-2.5v.5H21v1h-4v-4zm5 0h2l1 1.8 1-1.8h2l-2 2 2 2h-2l-1-1.8-1 1.8h-2l2-2-2-2z" fill="white"/></svg>
    </span>
    <span class="payment-badge-svg" title="Apple Pay">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="24" viewBox="0 0 36 24" fill="none"><rect width="36" height="24" rx="4" fill="#FFFFFF" stroke="#E5E5E5"/><path d="M12.8 10.7c0-.8.4-1.5 1.1-1.9-.5-.7-1.3-1.1-2.2-1.1-1 0-1.8.6-2.3.6-.5 0-1.2-.6-2.1-.6-1.1 0-2.2.7-2.7 1.7-1.2 2-0.3 5 0.8 6.6.6.8 1.2 1.7 2.1 1.7.9 0 1.2-.5 2.2-.5 1 0 1.3.5 2.2.5.9 0 1.5-.8 2-1.6.7-.9.9-1.8 1-1.9-.1 0-2.1-.8-2.1-3.5zm-1.6-4c.4-.5.7-1.3.6-2-.6 0-1.4.4-1.9 1-.4.5-.7 1.3-.6 2 .7.1 1.5-.4 1.9-1z" fill="black"/><text x="16.5" y="15.5" font-family="-apple-system, sans-serif" font-size="9" font-weight="600" fill="black">Pay</text></svg>
    </span>
    <span class="payment-badge-svg" title="Shop Pay">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="24" viewBox="0 0 36 24" fill="none"><rect width="36" height="24" rx="4" fill="#5A31F4"/><text x="5" y="15.5" font-family="sans-serif" font-size="9" font-weight="700" fill="white">Shop</text><text x="24" y="15.5" font-family="sans-serif" font-size="9" font-weight="400" fill="#9073F8">Pay</text></svg>
    </span>
  {% endif %}
</div>
