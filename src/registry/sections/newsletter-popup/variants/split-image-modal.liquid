{{ 'section-newsletter-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-newsletter-popup.js' | asset_url }}" defer="defer"></script>

<section class="newsletter-section nl-variant-split" style="--bg-color: {{ section.settings.background_color | default: '#0d0d0d' }}; --text-color: {{ section.settings.text_color | default: '#ffffff' }};">
  <div class="nl-split-container">
    <div class="nl-split-media">
      <img src="unsplash://luxury-lifestyle-model" alt="Newsletter" loading="lazy">
    </div>
    <div class="nl-split-content">
      <span class="nl-split-badge">EXCLUSIVE ACCESS</span>
      <h2 class="nl-split-title">{{ section.settings.title | default: "Join The Club" }}</h2>
      <p class="nl-split-desc">{{ section.settings.description | default: "Sign up to receive early access drops, secret promotions, and 15% off your first order." }}</p>

      <form class="nl-split-form">
        <input type="email" placeholder="Enter your email" required class="nl-split-input">
        <button type="submit" class="nl-split-btn">Join &rarr;</button>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Split Image Modal",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Join The Club" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Sign up to receive early access drops." }
  ]
}
{% endschema %}
